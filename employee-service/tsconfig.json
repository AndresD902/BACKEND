{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",

    "rootDir": "./src",
    "outDir": "dist",

    "baseUrl": "./src",
    "paths": {
      "*": ["*"]
    },

    "typeRoots": ["./src/types", "./node_modules/@types"],
    "types": ["node", "jest"],

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist", "coverage"]
}


