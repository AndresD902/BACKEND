            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_rrhh}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "cedula", "value": "112233445", "type": "text" },
                { "key": "firstName", "value": "Laura", "type": "text" },
                { "key": "lastName", "value": "Ramírez", "type": "text" },
                { "key": "gender", "value": "FEMALE", "type": "text" },
                { "key": "email", "value": "laura.ramirez@empresa.com", "type": "text" },
