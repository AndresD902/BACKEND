{
  "info": {
    "name": "Employee Service API",
    "description": "Colección completa para probar el Employee Service.\n\n**Requisitos previos:**\n1. El servicio debe estar corriendo en `{{base_url}}` (npm run dev)\n2. La base de datos PostgreSQL debe estar activa\n3. Configura los tokens JWT en el Environment antes de ejecutar los tests protegidos\n\n**Roles disponibles:**\n- `ADMIN`: puede hacer todo\n- `RRHH`: puede listar, crear, asignar contratos y ver historial\n- `CONSULTA`: solo puede listar y ver empleados",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3002"
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "description": "Verifica que el servicio y la base de datos estén operativos.",
      "item": [
        {
          "name": "GET Health — Servicio activo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Retorna 200 si la BD está conectada, 503 si no."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status es 200 o 503', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "",
                  "pm.test('Respuesta tiene estructura correcta', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('success');",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body.data).to.have.property('service');",
                  "    pm.expect(body.data).to.have.property('database');",
                  "});",
                  "",
                  "pm.test('Tiempo de respuesta < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('Content-Type es application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Autenticación (401 sin token)",
      "description": "Verifica que los endpoints protegidos rechacen peticiones sin Authorization header.",
      "item": [
        {
          "name": "GET /empleados — Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/empleados",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados"]
            },
            "description": "Sin Authorization header debe retornar 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sin token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error code es UNAUTHORIZED', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.false;",
                  "    pm.expect(body.error.code).to.equal('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /empleados — Sin token → 401",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/empleados",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sin token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /empleados/:id — Sin token → 401",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/empleados/{{empleado_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados", "{{empleado_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sin token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Empleados / Lectura",
      "description": "Endpoints de consulta accesibles por todos los roles autenticados.",
      "item": [
        {
          "name": "GET /empleados — Listar todos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_consulta}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/empleados",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados"]
            },
            "description": "Cualquier rol autenticado puede listar empleados. Retorna array sin passwordHash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta es un array', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Ningún empleado expone passwordHash', function () {",
                  "    const body = pm.response.json();",
                  "    body.data.forEach(emp => {",
                  "        pm.expect(emp).to.not.have.property('passwordHash');",
                  "        pm.expect(emp).to.not.have.property('password_hash');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Tiempo de respuesta < 1000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "// Guarda el primer ID para usarlo en los siguientes tests",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length > 0) {",
                  "    pm.environment.set('empleado_id', body.data[0].id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /empleados/:id — Buscar por ID (existe)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_consulta}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/empleados/{{empleado_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados", "{{empleado_id}}"]
            },
            "description": "Busca un empleado por ID. Usa el ID guardado en el test anterior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta tiene campos obligatorios', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data).to.have.property('id');",
                  "    pm.expect(body.data).to.have.property('cedula');",
                  "    pm.expect(body.data).to.have.property('firstName');",
                  "    pm.expect(body.data).to.have.property('lastName');",
                  "    pm.expect(body.data).to.have.property('email');",
                  "    pm.expect(body.data).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('No expone passwordHash', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data).to.not.have.property('passwordHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /empleados/:id — ID inexistente → 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_consulta}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/empleados/999999",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados", "999999"]
            },
            "description": "ID que no existe en la BD debe retornar 404 con código NOT_FOUND_ERROR."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Error code es NOT_FOUND_ERROR', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.false;",
                  "    pm.expect(body.error.code).to.equal('NOT_FOUND_ERROR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
