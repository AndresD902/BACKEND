    {
      "name": "05 - Empleados / Actualización de Identidad",
      "description": "PATCH /:id/identity — solo ADMIN puede modificar cédula, nombre, apellido.",
      "item": [
        {
          "name": "PATCH /identity — Rol RRHH → 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_rrhh}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"NuevoNombre\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/empleados/{{empleado_id}}/identity",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados", "{{empleado_id}}", "identity"]
            },
            "description": "Solo ADMIN puede modificar identidad. RRHH debe recibir 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 - RRHH no puede modificar identidad', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Error code es FORBIDDEN', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error.code).to.equal('FORBIDDEN');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /identity — Admin actualiza nombre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Laura Marcela\",\n  \"changeReason\": \"Corrección de nombre en documento de identidad\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/empleados/{{empleado_id}}/identity",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "empleados", "{{empleado_id}}", "identity"]
            },
            "description": "ADMIN actualiza el nombre de un empleado con razón del cambio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Nombre fue actualizado', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.firstName).to.equal('Laura Marcela');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
